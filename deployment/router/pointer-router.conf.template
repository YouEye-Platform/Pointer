pid __PID_FILE__;
error_log stderr notice;

events {
  worker_connections 1024;
}

http {
  access_log off;
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  client_max_body_size 32m;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
  }

  upstream pointer_server {
    server 127.0.0.1:__SERVER_PORT__;
    keepalive 32;
  }

  upstream pointer_web {
    server 127.0.0.1:__WEB_PORT__;
    keepalive 32;
  }

  server {
    listen 0.0.0.0:__LISTEN_PORT__;
    server_name _;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location = /healthz {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
    }

    location = /readyz {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
    }

    location = /.well-known/pointer {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
    }

    location = /api {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
    }

    location ^~ /api/ {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
    }

    location = /v1 {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location ^~ /v1/ {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location = /v1beta {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location ^~ /v1beta/ {
      proxy_pass http://pointer_server;
      include __PROXY_PARAMS__;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location / {
      proxy_pass http://pointer_web;
      include __PROXY_PARAMS__;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}
