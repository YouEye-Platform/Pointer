{
  "name": "@pointer/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:embed && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "next lint",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "test": "pnpm build && pnpm prepare:standalone && playwright test",
    "test:e2e": "pnpm build && pnpm prepare:standalone && playwright test",
    "test:e2e:headed": "pnpm build && pnpm prepare:standalone && playwright test --headed",
    "build:embed": "pnpm i18n:check && bun scripts/build-embed.mjs",
    "i18n:check": "node scripts/check-i18n.mjs && node scripts/check-i18n-source.mjs",
    "test:i18n": "node --test scripts/check-i18n.test.mjs scripts/host-runtime.test.mjs"
  },
  "dependencies": {
    "@pointer/contracts": "workspace:*",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
