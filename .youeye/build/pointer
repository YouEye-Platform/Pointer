#!/bin/bash
set -euo pipefail

fail() { printf 'pointer-build: %s\n' "$*" >&2; exit 1; }
require() { command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"; }

source_dir=${YOUEYE_SOURCE_DIR:-}
output_dir=${YOUEYE_OUTPUT_DIR:-}
work_dir=${YOUEYE_WORK_DIR:-}
source_tree=${YOUEYE_SOURCE_TREE:-}
source_epoch=${SOURCE_DATE_EPOCH:-}
[[ -d $source_dir ]] || fail 'YOUEYE_SOURCE_DIR must be an existing source directory'
[[ -n $output_dir && $output_dir != / && $output_dir != "$source_dir" ]] || fail 'YOUEYE_OUTPUT_DIR must be dedicated'
[[ -n $work_dir && $work_dir != / && $work_dir != "$source_dir" ]] || fail 'YOUEYE_WORK_DIR must be dedicated'
[[ -z $source_tree || $source_tree =~ ^[0-9a-f]{40}$ ]] || fail 'YOUEYE_SOURCE_TREE must be a 40-hex git tree'
[[ $source_epoch =~ ^[1-9][0-9]*$ ]] || fail 'SOURCE_DATE_EPOCH must be positive'
if [[ -e $source_dir/.git ]]; then
  [[ -z $source_tree || $(git -C "$source_dir" rev-parse 'HEAD^{tree}') == "$source_tree" ]] || fail 'checked-out tree does not match YOUEYE_SOURCE_TREE'
else
  # Permanent executor receives a credential-free git-archive export, not a live checkout.
  [[ -f $source_dir/apps/server/package.json ]] || fail 'credential-free source export is incomplete'
fi
require node
require pnpm
require bun
require tar
[[ $(node --version) == v22.23.2 ]] || fail 'Node 22.23.2 is required'
[[ $(pnpm --version) == 10.6.2 ]] || fail 'pnpm 10.6.2 is required'
[[ $(bun --version) == 1.4.2 ]] || fail 'Bun 1.4.2 is required'
[[ -n ${YOUEYE_PNPM_STORE_DIR:-} && -d $YOUEYE_PNPM_STORE_DIR ]] || fail 'reviewed pnpm store is required'

export LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
# VERSION holds the release line X.Y.Z; the release tool passes the full build version
# (X.Y.Z-rc.N) as YOUEYE_VERSION. Nothing in the source tree carries the build number.
line=$(tr -d '[:space:]' < "$source_dir/VERSION" 2>/dev/null || true)
[[ $line =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || fail 'VERSION must hold the release line X.Y.Z'
[[ -n ${YOUEYE_VERSION:-} ]] || fail "YOUEYE_VERSION is required: the full build version, e.g. $line-rc.1 (Tools/release/app-release assigns it)"
[[ $YOUEYE_VERSION =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[a-z][a-z0-9]*\.[1-9][0-9]*)?$ ]] || fail "YOUEYE_VERSION must be X.Y.Z[-token.N]; got $YOUEYE_VERSION"
[[ ${YOUEYE_VERSION%%-*} == "$line" ]] || fail "YOUEYE_VERSION $YOUEYE_VERSION is not on the VERSION line $line"
export YOUEYE_VERSION
stage=$work_dir/pointer-standalone
rm -rf -- "$stage"
install -d -m 0755 "$stage" "$output_dir"
cd "$source_dir"
pnpm install --frozen-lockfile --offline --package-import-method=copy --store-dir "$YOUEYE_PNPM_STORE_DIR"
pnpm public-source:check
pnpm typecheck
pnpm contracts:check
pnpm test:unit
bun build apps/server/src/index.ts --target=bun --external=@pointer/engine --define "process.env.YOUEYE_VERSION=\"$YOUEYE_VERSION\"" --outfile="$stage/server.js"
bun build apps/server/scripts/migrate.ts --target=bun --outfile="$stage/migrate.js"
bun build apps/server/scripts/transition-managed-identity.ts --target=bun --outfile="$stage/transition-managed-identity.js"
bun build apps/server/scripts/import-provider-state.ts --target=bun --external=@pointer/engine --outfile="$stage/import-provider-state.js"
pnpm --filter @pointer/web build:embed
cp -a apps/web/public/pointer-ui "$stage/ui"
npm_config_package_import_method=copy pnpm --offline --store-dir "$YOUEYE_PNPM_STORE_DIR" --filter @pointer/engine deploy --prod --legacy "$stage/engine"
# Legacy deploy retains development workspace aliases in its virtual store.
# Engine has no @pointer production dependencies; remove only those aliases.
node --input-type=module - "$stage/engine" <<'ENGINE_WORKSPACE_ALIASES'
import {lstatSync, readlinkSync, rmSync} from 'node:fs';
import {resolve, relative, isAbsolute} from 'node:path';
const root = resolve(process.argv[2]);
for (const name of ['server', 'web', 'cli', 'contracts', 'engine']) {
  const file = resolve(root, 'node_modules/.pnpm/node_modules/@pointer', name);
  let stat; try { stat = lstatSync(file); } catch (error) { if (error.code === 'ENOENT') continue; throw error; }
  if (!stat.isSymbolicLink()) throw new Error('Unexpected workspace alias type: @pointer/' + name);
  const target = resolve(file, '..', readlinkSync(file));
  const rel = relative(root, target);
  if (rel === '..' || rel.startsWith('../') || isAbsolute(rel)) {
    rmSync(file);
    console.log('Removed development workspace alias @pointer/' + name);
  }
}
ENGINE_WORKSPACE_ALIASES
install -d -m 0755 "$stage/node_modules/@pointer"
ln -s ../../engine "$stage/node_modules/@pointer/engine"
cp "$(command -v bun)" "$stage/bun"
chmod 0755 "$stage/bun"
cp apps/server/package.json "$stage/package.json"
cp LICENSE NOTICE.md "$stage/"
cp -a third-party "$stage/third-party"
cp -a apps/server/drizzle "$stage/drizzle"
cp -a apps/server/providers.d "$stage/providers.d"
find "$stage/providers.d" -type f -name '*.test.ts' -delete
node scripts/write-youeye-release-manifest.mjs "$stage"

temporary=$work_dir/standalone.tar.partial
output=$output_dir/standalone.tar
rm -f -- "$temporary" "$output"
tar --sort=name --format=posix --numeric-owner --owner=0 --group=0 \
  --mtime="@$source_epoch" --pax-option=delete=atime,delete=ctime \
  -C "$stage" -cf "$temporary" .
tar -tf "$temporary" ./bun ./server.js ./migrate.js ./transition-managed-identity.js ./import-provider-state.js ./ui/manifest.json ./release-manifest.json >/dev/null
mv -- "$temporary" "$output"
# The release's build contract: the same release-manifest.json, bound by product-release.json.
install -m 0644 "$stage/release-manifest.json" "$output_dir/pointer-build-contract.json"
sha256sum "$output"
